# ============================================================================
# rpi-power-monitor — systemd service (Raspberry Pi side)
#
# This file is a TEMPLATE: the __TOKEN__ placeholders are filled in by
#   deploy/install-service.sh
# which copies the result to /etc/systemd/system/rpi-power-monitor.service.
# You can also copy it manually and edit the values yourself.
#
# Install / manage (run on the Pi):
#   sudo ./deploy/install-service.sh             # install + enable + start
#   systemctl status rpi-power-monitor
#   journalctl -u rpi-power-monitor -f           # follow the log
#   sudo systemctl restart rpi-power-monitor
# ============================================================================

[Unit]
Description=Raspberry Pi INA3221 power monitor server (raw TCP + optional MQTT)
# Start once the network is up. Needed only for the optional MQTT publisher
# (paho reconnects on its own); remove the next two lines for a pure-LAN box
# to avoid any boot-order stall.
Wants=network-online.target
After=network-online.target

[Service]
Type=simple

# Service user/group. Must be able to open /dev/i2c-1 (member of the `i2c`
# group) and to write <repo>/state/energy.json (it owns the repo by default).
User=__USER__
Group=__GROUP__

# Repo root - `python -m server` is run from here so the top-level `server`
# and `shared` packages are importable, and config/state paths resolve.
WorkingDirectory=__REPO_DIR__

# venv python that has requirements/server.txt installed (PyYAML, smbus2,
# paho-mqtt), e.g.  <repo>/.venv/bin/python
ExecStart=__PYTHON__ -m server

# Keep stderr logging streaming into the journal.
Environment=PYTHONUNBUFFERED=1

# Restart on crash / sensor hiccup, but not on an explicit systemctl stop.
Restart=always
RestartSec=5

# The server turns SIGINT into KeyboardInterrupt to save energy totals and
# close sockets cleanly, so terminate it with SIGINT instead of SIGTERM.
KillSignal=SIGINT
TimeoutStopSec=15

# Logging: the server writes to stderr via logging.basicConfig; the journal
# is the log (view with `journalctl -u rpi-power-monitor -f`).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=rpi-power-monitor

[Install]
WantedBy=multi-user.target
